def cleanup():
    deleted = get_store().purge_expired()
    return {"deleted": deleted, "active": get_store().counts()["active"]}


@app.post("/keepalive/{slug}", dependencies=[Depends(require_admin)])
def keepalive(slug: str, req: KeepAliveReq, request: Request):
    if not 0 <= req.days <= 3650:
        raise HTTPException(400, "days must be between 0 and 3650")
    d = get_store().extend(slug, req.days)
    if not d:
        raise HTTPException(404, "Demo expired or unknown")
    return urls_for(request, d)


def urls_for(request: Request, d: dict) -> dict:
    base = base_url(request)
    out = {
        "slug": d["slug"],
        "brand": d["brand"],
        "domain": d["domain"],
        "model": d["model"],
        "demo_url": f"{base}/demo/{d['slug']}",
        "go_url": f"{base}/go/{d['slug']}",
        "pixel_url": f"{base}/pixel/{d['slug']}.gif",
        "embed_url": f"{base}/embed/{d['slug']}",
        "expires_at": iso(d["expires_at"]),
        "expires_in_days": ttl_days(),
    }
    if os.getenv("STRIPE_PAYMENT_LINK"):
        out["pay_url"] = f"{base}/pay/{d['slug']}"
    return out

def create_demo(url: str, model: str) -> dict:
    """Shared scrape -> slug -> store path behind /create and /request.
    Raises UnsafeTarget (SSRF guard) or ScrapeFailure (no usable content)."""
    profile = scrape_site(url)
    if not profile["corpus"]:
        raise ScrapeFailure("no usable content")
    slug = f"{slugify(profile['domain'])}-{uuid.uuid4().hex[:6]}"
    return get_store().create(
        slug=slug,
        domain=profile["domain"],
        brand=profile["brand"],
        model=model,
        corpus=profile["corpus"],
        faqs=profile["faqs_detected"],
        ttl_days=ttl_days(),
    )


@app.post("/create", dependencies=[Depends(require_admin)])
def create(req: CreateReq, request: Request):
    try:
        model = resolve_model(req.model)
    except UnknownModelError as e:
        raise HTTPException(400, str(e))
    try:
        d = create_demo(req.url, model)
    except UnsafeTarget as e:
        raise HTTPException(400, f"Refusing to scrape that URL: {e}")
    except ScrapeFailure:
        raise HTTPException(400, "Could not scrape usable content from that URL")
    return urls_for(request, d)


@app.post("/request", status_code=201)
def request_demo(req: RequestDemoReq, request: Request):
    """Public self-serve funnel: site URL + email -> demo created -> link
    emailed (emailed=true only when the delivery email actually sent).
    Rate-limited per client key (remote_addr; XFF only behind TRUSTED_PROXIES)
    plus a global per-hour creation cap; bodies over 16KB are refused before
    parsing; the scrape runs through the same SSRF-guarded path as /create."""
    enforce_rate_limit(client_ip(request))
    if not is_absolute_url(req.site_url):
        raise HTTPException(400, "invalid URL: expected an absolute http(s) URL")
    try:
        email = validate_email(req.email)
    except BadEmail as e:
        raise HTTPException(400, str(e))
    try:
        # Reuses the scraper's existing UnsafeTarget guard (not a second one) so
        # scheme/host refusals map to /create's error shape before any fetch.
        _assert_public_host(req.site_url)
    except UnsafeTarget as e:
        raise HTTPException(400, f"Refusing to scrape that URL: {e}")
    slot = reserve_creation()
    try:
        try:
            d = create_demo(req.site_url, resolve_model(None))
        except UnsafeTarget as e:
            raise HTTPException(400, f"Refusing to scrape that URL: {e}")
        except ScrapeFailure:
            raise HTTPException(502, "upstream scrape failure")
        except Exception as e:
            log.warning("scrape failed: %s", type(e).__name__)
            raise HTTPException(502, "upstream scrape failure") from e
    except BaseException:
        release_creation(slot)  # the cap counts creations, not attempts
        raise
    out = urls_for(request, d)
    emailed = False
    # Link integrity (R04): delivery links are built ONLY from
    # PUBLIC_BASE_URL. If it is unset the send is skipped — a Host-header-
    # derived link must never reach an inbox.
    public_base = (os.getenv("PUBLIC_BASE_URL") or "").rstrip("/")
    if public_base:
        try:
            emailed = send_demo_link(
                to_email=email,
                brand=d["brand"],
                go_url=f"{public_base}/go/{d['slug']}",
                expires_at=out["expires_at"],
            )
        except MailError as e:
            log.warning("demo link delivery failed: %s", e)
    out["emailed"] = emailed
    return out


@app.get("/demo/{slug}", response_class=HTMLResponse)
def demo_page(slug: str, embed: int = 0):
    d = get_store().get(slug)
    if not d:
        raise HTTPException(404, "Demo expired")
    brand = html.escape(d["brand"])  # external string, escaped at emission (R02)
    return render(
        CHAT_PAGE,
        BRAND=brand,
        SLUG=slug,
        BANNER="" if embed else render(BANNER_HTML, BRAND=brand),
        EMBED_CSS=EMBED_CSS if embed else "",
    )


# ---- lead capture (P1): best-effort extraction from USER messages only ----
# R1 hardening (R12): extraction is bounded — every user message is scanned
# only up to _EXTRACT_WINDOW chars — and every pattern below is single-path
# (one quantifier per class, no alternation backoff, no nested repeats), so
# no input shape can trigger backtracking blowup (R12-1 was a P0 GIL stall).
_EXTRACT_WINDOW = 2000  # chars scanned per user message
_MAX_NAME, _MAX_EMAIL = 80, 254
# phone needs no cap constant: it is 10-12 ASCII digits by construction
# (the contract's 20-char cap is subsumed — R13-5)

# Email: located by an @-anchored scan (_find_email), then the maximal
# candidate must fullmatch this non-overlapping shape.
_EMAIL_FULL_RE = re.compile(
    r"[A-Za-z0-9_%+-]+(?:\.[A-Za-z0-9_%+-]+)*"  # dot-separated local atoms
    r"@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*"       # dot-separated domain labels
    r"\.[A-Za-z]{2,24}"                         # TLD
)
_LOCAL_CHARS = frozenset(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._%+-")
_DOMAIN_CHARS = frozenset(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-.")
# Phone: candidates are MAXIMAL spans of ASCII digits + phone punctuation;
# the whole span is validated, so a spaced 16-digit card can never be
# captured as a 12-digit prefix slice (R12-2).
_PHONE_SPAN_RE = re.compile(r"[0-9()+. +\-]+")
_SPAN_TOKEN_RE = re.compile(r"[0-9]+|[^0-9]+")  # digit groups / joins (R13-2)
# Name: explicit intro patterns ONLY — exactly the spec's four ("X here"
# dropped, R12-3; bare "its" dropped, R13-4): my name is X, name's X,
# this is X, it's X. X is 1-2 words, first char a letter; the continuation
# class is permissive (single quantifier, linear — R12-1) and the word is
# validated in extract_lead: Unicode letters + internal ' ’ - + combining
# marks (NFD input) only, initial capital per slot, reject-not-truncate —
# a word cut mid-word rejects the whole capture, never a partial name.
_NAME_RE = re.compile(
    r"\b(?i:my\s+name(?:\s+is|['’]s)|name['’]s|this\s+is|it['’]s)"
    r"\s+([^\W\d_][\w'’\-\u0300-\u036f]*)(?:\s+([^\W\d_][\w'’\-\u0300-\u036f]*))?"
)
_NAME_STOPWORDS = frozenset(
    "a an the my our your his her its their this that these those i we you he "
    "she it me him them us is am are was were be been to of in on at for with "
    "and or but not no yes here there who what when where why how all any some "
    "every someone anyone everyone nobody somebody something anything question "
    "urgent please thanks thank hello hi hey good morning afternoon evening "
    "night help need want can could would should just also really very too "
    "call text email phone name contact team support "
    # weekdays are never names here ('it's Friday' — R13-4); month names
    # stay capturable (May/June/April/August are legitimate given names)
    "monday tuesday wednesday thursday friday saturday sunday "
    "great pizza".split())


def _sanitize_field(value: str, max_len: int) -> str:
    """Boundary sanitizer (R12-5, #31): collapse every whitespace run —
    CR/LF, NEL (U+0085), LS (U+2028), PS (U+2029), Zs — to a single space
    FIRST so words never glue, then drop remaining Cc/Cf (controls,
    bidi-format); finally trim and cap."""
    cleaned = []
    for ch in value:
        if ch.isspace() or unicodedata.category(ch) in ("Zl", "Zp"):
            cleaned.append(" ")
        elif unicodedata.category(ch) in ("Cc", "Cf"):
            continue
        else:
            cleaned.append(ch)
    return " ".join("".join(cleaned).split())[:max_len]


def _luhn_ok(digits: str) -> bool:
    """Luhn checksum over ASCII digits: True means payment-card signal, not
    a phone (R12-2 contract, pinned by test_luhn_card_signals_both_ways).

    Extraction's 10-12 digit length gate rejects every 13-16 digit candidate
    before any checksum could matter, so the old in-line branches were
    vacuous and were removed (R13-5)."""
    total = 0
    for i, ch in enumerate(reversed(digits)):
        d = ord(ch) - 48
        if i % 2:
            d *= 2
            if d > 9:
                d -= 9
        total += d
    return total % 10 == 0


_DATE_SEP = frozenset("-/.")  # date separators (R13-2)


def _is_date_join(sep: str) -> bool:
    """A date join is one or more date separators, optionally space-padded
    ('2024-10-01' or '2024 - 10 - 01'); spaces alone, parens and '+' are
    phone punctuation and disqualify the form."""
    core = sep.strip(" ")
    return bool(core) and all(c in _DATE_SEP for c in core)


def _looks_like_date(tokens: list[str]) -> bool:
    """Genuine date forms only (R13-2): three consecutive digit groups
    joined by date separators in Y-M-D (4-2-2) or D-M-Y/M-D-Y (2-2-4) shape
    with plausible year (1900-2099), month (1-12) and day (1-31) ranges.
    Phone group runs never match: '+1 202 555 2020' and '1-800-555-1999'
    stay capturable while '2024-10-01 08' slices stay rejected."""
    if tokens and not tokens[0][0].isdigit():
        tokens = tokens[1:]  # span may open with punctuation ("+1 ...")
    for i in range(0, len(tokens) - 4, 2):
        g1, sep1, g2, sep2, g3 = tokens[i:i + 5]
        if not (_is_date_join(sep1) and _is_date_join(sep2)):
            continue
        shape = (len(g1), len(g2), len(g3))
        if shape == (4, 2, 2):
            year, month, day = int(g1), int(g2), int(g3)
            if 1900 <= year <= 2099 and 1 <= month <= 12 and 1 <= day <= 31:
                return True
        elif shape == (2, 2, 4):
            # 2-2-4 is D-M-Y or M-D-Y (indistinguishable): both leading
            # parts must look like day-or-month, one of them a month.
            a, b, year = int(g1), int(g2), int(g3)
            if (1 <= a <= 31 and 1 <= b <= 31 and min(a, b) <= 12
                    and 1900 <= year <= 2099):
                return True
    return False


def _phone_from_span(span: str) -> str | None:
    """Validate one maximal phone span; normalized ASCII digits or None.
    The 10-12 digit length gate is the rule (ratified NA-length gate, R12-2):
    it subsumes the old contiguous-run bound and rejects every 13+ digit run
    (cards, long order IDs). Genuine date forms are rejected on top (R13-2)."""
    tokens = _SPAN_TOKEN_RE.findall(span)
    if _looks_like_date(tokens):
        return None
    digits = "".join(t for t in tokens if t[0].isdigit())
    return digits if 10 <= len(digits) <= 12 else None


def _find_email(window: str, edge_cut: bool = False) -> str | None:
    """Email lookup, provably linear: @-anchored (literal-first) scan; the
    left expansion cannot cross an '@' and right runs never overlap, so the
    total work is O(len(window)). The maximal candidate must fullmatch
    _EMAIL_FULL_RE (anchored, single-path). With edge_cut — the message
    continues past the window — a candidate whose maximal span reaches the
    window edge is a truncated contact and is discarded (R13-3): skipped,
    never stored, never a dedupe key; scanning continues for a complete
    in-window candidate."""
    at = window.find("@")
    n = len(window)
    while at != -1:
        start = at
        while start > 0 and window[start - 1] in _LOCAL_CHARS:
            start -= 1
        end = at + 1
        while end < n and window[end] in _DOMAIN_CHARS:
            end += 1
        cand = window[start:end].rstrip(".")
        if cand and _EMAIL_FULL_RE.fullmatch(cand):
            if not (edge_cut and end == n):
                return cand
        at = window.find("@", at + 1)
    return None


def _is_word_char(ch: str) -> bool:
    """\\w semantics for the reject-not-truncate boundary (R13-1); combining
    marks count — an NFD word cut at a mark is a cut, not a name."""
    return (ch == "_" or ch.isalnum()
            or unicodedata.category(ch) in ("Mn", "Me"))


def _is_name_char(ch: str) -> bool:
    """A name word is Unicode letters, internal apostrophes/hyphens and
    combining marks (NFD input). Anything else — digits, underscore — means
    the word was cut mid-word (R13-1)."""
    return (ch.isalpha() or ch in "'’-"
            or unicodedata.category(ch) in ("Mn", "Me"))


def _stopword_key(word: str) -> str:
    """Fold a candidate name word for the stopword check (R13-1): NFKD,
    drop combining marks, casefold — 'Urgént' cannot evade the 'urgent'
    stopword by mid-word accent substitution."""
    decomposed = unicodedata.normalize("NFKD", word)
    stripped = "".join(c for c in decomposed if unicodedata.category(c) != "Mn")
    return stripped.casefold()


def extract_lead(messages: list[dict]) -> dict | None:
    """Best-effort contact capture from user-role messages only (Contract 2).

    R1 hardening: each user message is scanned only up to _EXTRACT_WINDOW
    chars and all classes are linear/non-overlapping (R12-1). Phone: ASCII
    [0-9] only, 10-12 digit length gate, genuine date shapes out (R12-2,
    R13-2). Name: the spec's four intro patterns, 1-2 initial-capital
    Unicode-letter words, folded stopword check, and reject-not-truncate:
    a word ending mid-word rejects the whole capture (R12-3, R13-1, R13-4).
    Window edge (R13-3): when the message continues past the window, any
    candidate whose span ends at the cut is discarded — a truncated contact
    must never be stored or key dedupe. Fields are sanitized at the boundary
    (R12-5). Never raises: worst case no lead.
    """
    try:
        email = phone = name = ""
        for m in messages:
            if not isinstance(m, dict) or m.get("role") != "user":
                continue
            content = m.get("content")
            if not isinstance(content, str):
                continue
            window = content[:_EXTRACT_WINDOW]
            edge_cut = len(content) > _EXTRACT_WINDOW
            if not email:
                hit = _find_email(window, edge_cut)
                if hit:
                    email = _sanitize_field(hit, _MAX_EMAIL)
            if not phone:
                for span in _PHONE_SPAN_RE.finditer(window):
                    if edge_cut and span.end() == len(window):
                        continue  # truncated candidate (R13-3)
                    digits = _phone_from_span(span.group(0))
                    if digits:
                        phone = digits  # 10-12 ASCII digits as-is
                        break
            if not name:
                for hit in _NAME_RE.finditer(window):
                    end = hit.end()
                    if end < len(window) and _is_word_char(window[end]):
                        continue  # cut mid-word: reject, never partial (R13-1)
                    if edge_cut and end == len(window):
                        continue  # truncated candidate (R13-3)
                    words = []
                    for w in (w for w in hit.groups() if w):
                        if not all(_is_name_char(c) for c in w):
                            words = None  # cut mid-word: reject whole (R13-1)
                            break
                        if not w[0].isupper():
                            break  # each slot requires an initial capital
                        words.append(w)
                    if not words:
                        continue
                    if any(_stopword_key(w) in _NAME_STOPWORDS for w in words):
                        continue  # stopword hit: keep searching
                    name = _sanitize_field(" ".join(words), _MAX_NAME)
                    break
            if email and phone and name:
                break
        if not (email or phone or name):
            return None
        return {"name": name, "email": email, "phone": phone}
    except Exception:
        return None


@app.post("/api/chat/{slug}")
def api_chat(slug: str, req: ChatReq):
    d = get_store().get(slug)
    if not d:
        raise HTTPException(404, "Demo expired")
    messages = req.messages[-10:]
    if not messages or any(
        not isinstance(m, dict)
        or m.get("role") not in ("user", "assistant")
        or not isinstance(m.get("content"), str)
        for m in messages
    ):
        raise HTTPException(400, "messages must be [{role, content}, ...]")
    get_store().bump(slug, "chats")
    lead = extract_lead(messages)  # user messages only; never raises
    if lead and (lead["email"] or lead["phone"]):
        # only contactable captures are leads (record_lead dedupes on them)
        get_store().record_lead(slug, lead["name"], lead["email"], lead["phone"])
    try:
        reply = chat(d, messages, model=d["model"])
    except Exception as e:
        raise HTTPException(502, f"chat backend error: {e}")
    return {"reply": reply, "model": d["model"]}



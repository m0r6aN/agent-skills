    return render(
        SNIPPET_PAGE,
        BASE=base,
        SLUG=slug,
        BRAND=html.escape(d["brand"]),
        PAY_BLOCK=render(PAY_BLOCK, PAY_URL=html.escape(pay_url)) if pay_url else "",
    )



RATE_WINDOW_SECONDS = 3600.0
FULL_PRUNE_INTERVAL = 60.0
MAX_RATE_KEY_LEN = 64

_rate_lock = threading.Lock()
_rate_by_ip: dict[str, list[float]] = {}
_creations: list[float] = []
_last_full_prune = 0.0


def reset_rate_limits() -> None:
    """Test seam: clear the in-memory rate buckets (per-key + global)."""
    global _last_full_prune
    with _rate_lock:
        _rate_by_ip.clear()
        _creations.clear()
        _last_full_prune = 0.0


def requests_per_hour() -> int:
    try:
        n = int(os.getenv("REQUESTS_PER_HOUR", "5"))
    except ValueError:
        return 5
    return n if n >= 1 else 5


def max_demos_per_hour() -> int:
    try:
        n = int(os.getenv("MAX_DEMOS_PER_HOUR", "30"))
    except ValueError:
        return 30
    return n if n >= 1 else 30


def trusted_proxies() -> int:
    """How many X-Forwarded-For entries were appended by trusted hops.
    0 (the default and any invalid value) means XFF is ignored entirely."""
    try:
        n = int(os.getenv("TRUSTED_PROXIES", ""))
    except ValueError:
        return 0
    return n if n >= 1 else 0


def client_ip(request: Request) -> str:
    """Rate-limit key: the direct peer (remote_addr) by default.

    X-Forwarded-For is honored ONLY when TRUSTED_PROXIES (int >= 1) is set,
    and then the key is the entry appended by the Nth trusted hop counting
    from the right (XFF[-N]) — never the attacker-controlled leftmost
    entries. If the XFF chain is shorter than the trusted-hop count, it is
    incomplete and we fail closed to remote_addr. Keys are length-capped."""
    key = request.client.host if request.client else "unknown"
    n = trusted_proxies()
    if n >= 1:
        xff = request.headers.get("x-forwarded-for", "")
        entries = [e.strip() for e in xff.split(",") if e.strip()]
        if len(entries) >= n:
            key = entries[-n]
    return key[:MAX_RATE_KEY_LEN]


def _prune_bucket(bucket: list[float], now: float) -> None:
    cutoff = now - RATE_WINDOW_SECONDS
    bucket[:] = [t for t in bucket if t > cutoff]


def _maybe_full_prune(now: float) -> None:
    """At most once per FULL_PRUNE_INTERVAL: drop every stale hit and delete
    every empty key, so the buckets cannot grow without bound (F2)."""
    global _last_full_prune
    if now - _last_full_prune < FULL_PRUNE_INTERVAL:
        return
    for key in list(_rate_by_ip):
        bucket = _rate_by_ip[key]
        _prune_bucket(bucket, now)
        if not bucket:
            del _rate_by_ip[key]
    _prune_bucket(_creations, now)
    _last_full_prune = now


def enforce_rate_limit(key: str) -> None:
    """In-memory per-key counter over a trailing one-hour window. The
    check-and-record step runs under a lock so concurrent requests cannot
    race past the limit (R14); stale buckets are pruned (F2). State resets on
    restart — documented caveat."""
    now = time.time()
    with _rate_lock:
        _maybe_full_prune(now)
        bucket = _rate_by_ip.get(key)
        if bucket is not None:
            _prune_bucket(bucket, now)
            if not bucket:
                del _rate_by_ip[key]
                bucket = None
        if bucket is not None and len(bucket) >= requests_per_hour():
            raise HTTPException(429, "rate limit exceeded, try again later")
        _rate_by_ip.setdefault(key, []).append(now)


def reserve_creation() -> float:
    """Spoof-resilient global generation cap (R03): MAX_DEMOS_PER_HOUR demo
    creations per hour across ALL clients. Returns a token the caller MUST
    pass to release_creation() if the creation fails — the cap counts
    creations, not attempts."""
    now = time.time()
    with _rate_lock:
        _maybe_full_prune(now)
        _prune_bucket(_creations, now)
        if len(_creations) >= max_demos_per_hour():
            raise HTTPException(429, "rate limit exceeded, try again later")
        _creations.append(now)
        return now


def release_creation(token: float) -> None:
    """Give back a reserved creation slot when the creation failed."""
    with _rate_lock:
        try:
            _creations.remove(token)
        except ValueError:
            pass


def is_absolute_url(url: str) -> bool:
    """Input-shape gate: the URL must carry a scheme. Scheme/host policing is
    the scraper guard's job (UnsafeTarget), not a second validator's."""
    if not isinstance(url, str) or not url:
        return False
    try:
        return bool(urlparse(url).scheme)
    except ValueError:
        return False


def ttl_days() -> int:
    try:
        return int(os.getenv("DEMO_TTL_DAYS", str(TTL_DAYS_DEFAULT)))
    except ValueError:
        return TTL_DAYS_DEFAULT


def base_url(request: Request) -> str:
    return (os.getenv("PUBLIC_BASE_URL") or str(request.base_url)).rstrip("/")


def iso(ts: float) -> str:
    return datetime.fromtimestamp(ts, tz=timezone.utc).isoformat()


def require_admin(x_admin_token: str | None = Header(default=None)) -> None:
    expected = os.getenv("ADMIN_TOKEN")
    if not expected:
        raise HTTPException(503, "ADMIN_TOKEN not configured")
    if not x_admin_token or not secrets.compare_digest(x_admin_token, expected):
        raise HTTPException(401, "bad or missing X-Admin-Token")


def slugify(domain: str) -> str:
    host = domain.lower()
    if host.startswith("www."):
        host = host[4:]
    s = re.sub(r"[^a-z0-9]+", "", host.split(".")[0])
    return s[:24] or "demo"


_RENDER_TOKEN_RE = re.compile(r"__([A-Z][A-Z0-9_]*)__")


def render(template: str, **subs: str) -> str:
    """Single-pass substitution: each token is replaced exactly once and a
    substituted value is never re-scanned, so a value that itself contains a
    __TOKEN__ pattern cannot chain into a later substitution (R5#3)."""
    return _RENDER_TOKEN_RE.sub(lambda m: subs.get(m.group(1), m.group(0)), template)



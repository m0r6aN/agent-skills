# Copy to .env and fill in. Never commit .env.

# Required: OpenRouter API key (chat inference)
OPENROUTER_API_KEY=sk-or-...

# Optional: pin the default model (catalog: openai/gpt-4.1-nano,
# xiaomi/mimo-v2.6-pro, openai/gpt-6-luna, meta/muse-spark-1.3).
# Default: openai/gpt-4.1-nano (fastest/cheapest verified)
# OPENROUTER_MODEL=openai/gpt-4.1-nano

# Required in production: absolute base for links in emails/snippets
# PUBLIC_BASE_URL=https://demo-bot.azurecontainerapps.io

# Required: guards /create, /stats, /cleanup (they fail closed without it)
# ADMIN_TOKEN=change-me-long-random-string

# Optional: SQLite path (default data/demos.db)
# DEMOS_DB=data/demos.db

# Optional: force the lockless SQLite connection (set 1 on filesystems whose
# file locks reject SQLite, e.g. Azure Files CIFS; normally auto-detected at
# connect via a write probe)
# DEMOS_DB_NOLOCK=1

# Optional: demo lifetime in days (default 14)
# DEMO_TTL_DAYS=14

# Stripe payment link (one checkout: Setup $500 + Care Plan $200/mth;
# products prod_VLq227HRojVzLX + prod_VLq1nHOUwoseVK); enables /pay/{slug}
STRIPE_PAYMENT_LINK=https://buy.stripe.com/00weVdg1GczqemH6Ccebu00

# Required to render outreach emails (CAN-SPAM fail-closed)
# POSTAL_ADDRESS=1 Main St, Austin TX 78701
# UNSUBSCRIBE_URL=https://chatdoorman.com/unsubscribe

# Optional: signature name (default Clint)
# SENDER_NAME=Clint

# SMTP delivery for POST /request demo links (all five required to send;
# any missing => the demo is still created but emailed=false — same for a
# missing POSTAL_ADDRESS/UNSUBSCRIBE_URL above, CAN-SPAM fail-closed)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=demos
# SMTP_PASSWORD=change-me
# SMTP_FROM=demos@chatdoorman.com

# Optional: POST /request per-key rate limit per hour (default 5).
# The key is remote_addr by default; X-Forwarded-For is honored ONLY when
# TRUSTED_PROXIES is set (see below).
# REQUESTS_PER_HOUR=5

# Optional: how many X-Forwarded-For entries were appended by trusted proxy
# hops (default 0 = XFF ignored, rate key is remote_addr). When set to N >= 1
# the rate key is XFF[-N], the entry appended by the Nth trusted hop counting
# from the right — never the attacker-controlled leftmost entries.
# TRUSTED_PROXIES=1

# Optional: global cap on demo creations per hour across ALL clients
# (spoof-resilient backstop for the funnel; default 30)
# MAX_DEMOS_PER_HOUR=30

# Optional: total wall-clock budget for one site scrape in seconds
# (default 30); also bounds the wait for a scrape slot
# SCRAPE_BUDGET_SECONDS=30

# Optional: max concurrent site scrapes (default 4) — protects the worker
# pool from scrape starvation
# SCRAPE_MAX_IN_FLIGHT=4

# Optional: max bytes read per scraped response (default 2097152 = 2 MiB);
# oversized response bodies are truncated at this size
# SCRAPE_MAX_BYTES=2097152

# Lead pipeline (pipeline.py / leads.py)
# HUNTER_API_KEY=...
# OUTSCRAPER_API_KEY=...
# DEMO_SERVER_URL=https://demo.chatdoorman.com

# Optional: ESP push for campaign.py --send
# INSTANTLY_API_KEY=...
# SMARTLEAD_API_KEY=...

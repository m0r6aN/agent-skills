"""
SQLite persistence for demo bots.

Replaces the v1 in-memory dict so demos survive restarts and scale-to-zero.
Single file, single table; journal mode is negotiated at connect (WAL where
the filesystem supports it). Swap for Azure Table Storage later if
multi-replica writes ever matter.
"""
import json
import os
import sqlite3
import threading
import time

DEFAULT_DB = os.path.join("data", "demos.db")

_SCHEMA = """
CREATE TABLE IF NOT EXISTS demos (
    slug        TEXT PRIMARY KEY,
    domain      TEXT NOT NULL,
    brand       TEXT NOT NULL,
    model       TEXT NOT NULL,
    corpus      TEXT NOT NULL,
    faqs_json   TEXT NOT NULL DEFAULT '[]',
    created_at  REAL NOT NULL,
    expires_at  REAL NOT NULL,
    opens       INTEGER NOT NULL DEFAULT 0,
    clicks      INTEGER NOT NULL DEFAULT 0,
    chats       INTEGER NOT NULL DEFAULT 0,
    paid_clicks INTEGER NOT NULL DEFAULT 0,
    leads_json  TEXT NOT NULL DEFAULT '[]'
);
CREATE INDEX IF NOT EXISTS idx_demos_expires ON demos(expires_at);
"""

_MIGRATIONS = (
    # (column, DDL) — applied in order to DBs created before the column existed
    ("leads_json", "ALTER TABLE demos ADD COLUMN leads_json TEXT NOT NULL DEFAULT '[]'"),
)

COUNTERS = ("opens", "clicks", "chats", "paid_clicks")
MAX_LEADS = 200  # per demo, FIFO: oldest dropped beyond this (R12-4)
_ROW_FIELDS = (
    "slug", "domain", "brand", "model", "corpus", "created_at", "expires_at",
    *COUNTERS,
)


class StoreInitError(RuntimeError):
    """The demo store could not be opened in any connection mode."""


class Store:
    def __init__(self, db_path: str | None = None):
        self.db_path = db_path or os.getenv("DEMOS_DB") or DEFAULT_DB
        parent = os.path.dirname(self.db_path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        self._lock = threading.Lock()
        self._conn = self._connect()
        self._conn.row_factory = sqlite3.Row

    def _connect(self) -> sqlite3.Connection:
        """Open the demo store DB with connection resilience.

        Invariant: one engine replica, one writer process; the process-level
        threading.Lock serializes ops; SQLite file locking is disabled
        (nolock=1) when the filesystem rejects locks (Azure Files CIFS).

        Chain: WAL -> DELETE journal -> lockless (nolock=1, journal DELETE).
        Every candidate must pass a real WRITE PROBE (_probe_write) before it
        is accepted: on CIFS the PRAGMA and the IF NOT EXISTS schema can
        succeed on a locking connection while the first real write later
        fails ("database is locked" at create/extend), so a read-only init is
        not proof of a usable connection. An OperationalError at ANY step
        (pragma, schema, probe) discards the candidate and falls through to
        the next; the nolock connection is the deterministic landing.
        DEMOS_DB_NOLOCK=1 skips straight to it. StoreInitError only if even
        the nolock connection cannot pass the write probe.
        """
        if os.getenv("DEMOS_DB_NOLOCK"):
            return self._open_nolock()
        try:
            return self._open(journal_mode="WAL")
        except sqlite3.OperationalError:
            pass
        try:
            return self._open(journal_mode="DELETE")
        except sqlite3.OperationalError:
            pass
        return self._open_nolock()

    def _open(self, *, journal_mode: str,
              nolock: bool = False) -> sqlite3.Connection:
        """One connect-chain candidate: open, set journal mode, apply schema,
        then prove real writes work. Raises sqlite3.OperationalError on any
        failure so _connect can fall through."""
        if nolock:
            conn = sqlite3.connect(f"file:{self.db_path}?nolock=1", uri=True,
                                   check_same_thread=False)
        else:
            conn = sqlite3.connect(self.db_path, check_same_thread=False)
        try:
            conn.execute(f"PRAGMA journal_mode={journal_mode}")
            with self._lock, conn:
                conn.executescript(_SCHEMA)
                self._migrate(conn)
            self._probe_write(conn)
        except sqlite3.OperationalError:
            self._discard(conn)
            raise
        return conn

    def _open_nolock(self) -> sqlite3.Connection:
        """Deterministic landing: lockless connection, journal DELETE.
        Raises StoreInitError if even this cannot pass the write probe."""
        try:
            return self._open(journal_mode="DELETE", nolock=True)
        except sqlite3.OperationalError as exc:
            raise StoreInitError(
                f"demo store unusable at {self.db_path}: {exc}"
            ) from exc

    @staticmethod
    def _migrate(conn: sqlite3.Connection) -> None:
        """Add columns missing from DBs created before the current schema
        (the live Azure Files DB predates leads_json). CREATE TABLE IF NOT
        EXISTS never alters an existing table, so each migration is guarded
        on the column's absence and skipped when already present."""
        cols = {row[1] for row in conn.execute("PRAGMA table_info(demos)")}
        for col, ddl in _MIGRATIONS:
            if col not in cols:
                conn.execute(ddl)

    @staticmethod
    def _probe_write(conn: sqlite3.Connection) -> None:
        """Prove the connection can run a real write transaction and roll it
        back — the lock/journal path (BEGIN IMMEDIATE -> journal
        create/extend -> rollback) that create()/extend()/bump() need.

        Leaves no trace: the throwaway table is dropped and the transaction
        rolled back.
        """
        conn.execute("BEGIN IMMEDIATE")
        conn.execute("CREATE TABLE IF NOT EXISTS _store_write_probe (x)")
        conn.execute("DROP TABLE IF EXISTS _store_write_probe")
        conn.rollback()

    @staticmethod
    def _discard(conn: sqlite3.Connection) -> None:
        """Close a failed candidate without masking the failure being
        handled (on a wedged filesystem close/rollback can itself raise)."""
        try:
            conn.close()
        except sqlite3.Error:
            pass

    def create(self, *, slug, domain, brand, model, corpus, faqs=None,
               ttl_days: int = 14) -> dict:
        now = time.time()
        row = {
            "slug": slug,
            "domain": domain,
            "brand": brand,
            "model": model,
            "corpus": corpus,
            "faqs_json": json.dumps(faqs or []),
            "created_at": now,
            "expires_at": now + ttl_days * 24 * 3600,
        }
        with self._lock, self._conn:
            self._conn.execute(
                """INSERT INTO demos
                   (slug, domain, brand, model, corpus, faqs_json, created_at, expires_at)
                   VALUES (:slug, :domain, :brand, :model, :corpus, :faqs_json,
                           :created_at, :expires_at)""",
                row,
            )
        # return the row directly (bypasses get()'s lazy expiry purge)
        return {
            **{k: row[k] for k in ("slug", "domain", "brand", "model", "corpus",
                                   "created_at", "expires_at")},
            "faqs_detected": json.loads(row["faqs_json"]),
            "leads": [],
            **{c: 0 for c in COUNTERS},
        }

    def get(self, slug: str) -> dict | None:
        with self._lock:
            cur = self._conn.execute("SELECT * FROM demos WHERE slug = ?", (slug,))
            row = cur.fetchone()
        if row is None:
            return None
        d = self._to_dict(row)
        if d["expires_at"] <= time.time():
            self.delete(slug)
            return None
        return d

    def bump(self, slug: str, counter: str) -> bool:
        if counter not in COUNTERS:
            raise ValueError(f"unknown counter: {counter}")
        with self._lock, self._conn:
            cur = self._conn.execute(
                f"UPDATE demos SET {counter} = {counter} + 1 WHERE slug = ?", (slug,)
            )
        return cur.rowcount > 0

    def extend(self, slug: str, days: int) -> dict | None:
        """Keep a demo alive: expires_at = now + days (used when a prospect says YES)."""
        if days < 0:
            raise ValueError("days must be >= 0")
        with self._lock, self._conn:
            cur = self._conn.execute(
                "UPDATE demos SET expires_at = ? WHERE slug = ?",
                (time.time() + days * 24 * 3600, slug),
            )
            if cur.rowcount == 0:
                return None
            row = self._conn.execute("SELECT * FROM demos WHERE slug = ?", (slug,)).fetchone()
        return self._to_dict(row)

    def record_lead(self, slug: str, name: str, email: str, phone: str) -> bool:
        """Store a captured lead on the demo row (leads_json list of
        {name, email, phone, captured_at, last_seen}).

        Dedupe on email OR phone: a repeat contact updates last_seen and is
        never duplicated; a new contact appends. On a hit, EMPTY fields are
        backfilled from the new capture (the prompt's two-step flow must not
        leave permanently incomplete leads — R12-3); non-empty fields are
        never overwritten. The list is capped at MAX_LEADS per demo, oldest
        entries dropped first (R12-4). Needs at least one of email/phone (the
        dedupe keys) — unknown slug or no contact is a no-op returning False.
        """
        if not email and not phone:
            return False
        now = time.time()
        with self._lock, self._conn:
            row = self._conn.execute(
                "SELECT leads_json FROM demos WHERE slug = ?", (slug,)
            ).fetchone()
            if row is None:
                return False
            try:
                leads = json.loads(row["leads_json"])
            except ValueError:
                leads = []
            if not isinstance(leads, list):
                leads = []
            for lead in leads:
                if not isinstance(lead, dict):
                    continue
                if (email and lead.get("email") == email) or (
                    phone and lead.get("phone") == phone
                ):
                    lead["last_seen"] = now
                    for key, val in (("name", name), ("email", email), ("phone", phone)):
                        if val and not lead.get(key):
                            lead[key] = val
                    break
            else:
                leads.append({
                    "name": name,
                    "email": email,
                    "phone": phone,
                    "captured_at": now,
                    "last_seen": now,
                })
                if len(leads) > MAX_LEADS:
                    del leads[:len(leads) - MAX_LEADS]
            self._conn.execute(
                "UPDATE demos SET leads_json = ? WHERE slug = ?",
                (json.dumps(leads), slug),
            )
        return True

    def delete(self, slug: str) -> bool:
        with self._lock, self._conn:
            cur = self._conn.execute("DELETE FROM demos WHERE slug = ?", (slug,))
        return cur.rowcount > 0

    def purge_expired(self) -> int:
        with self._lock, self._conn:
            cur = self._conn.execute(
                "DELETE FROM demos WHERE expires_at <= ?", (time.time(),)
            )
        return cur.rowcount

    def counts(self) -> dict:
        with self._lock:
            cur = self._conn.execute("SELECT COUNT(*) FROM demos")
            total = cur.fetchone()[0]
            cur = self._conn.execute(
                "SELECT COUNT(*) FROM demos WHERE expires_at > ?", (time.time(),)
            )
            active = cur.fetchone()[0]
        return {"active": active, "total_rows": total}

    @staticmethod
    def _to_dict(row: sqlite3.Row) -> dict:
        d = {k: row[k] for k in _ROW_FIELDS}
        d["faqs_detected"] = json.loads(row["faqs_json"])
        d["leads"] = json.loads(row["leads_json"])
        return d

    def close(self) -> None:
        self._conn.close()

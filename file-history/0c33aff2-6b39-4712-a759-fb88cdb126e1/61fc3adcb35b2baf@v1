import pipeline
from leads import Config


def _cfg(**kw):
    defaults = dict(chain_threshold=5, verify=True,
                    fetch_fn=lambda url, timeout=15:
                    "<script src='js.intercom.io'></script>" if "chatty" in url
                    else "<html>hello</html>",
                    verify_fn=lambda e: "deliverable")
    defaults.update(kw)
    return Config(**defaults)



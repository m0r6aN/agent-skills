     "rating": 4.2, "reviews": 100, "business_status": "OPERATIONAL", "email": ""},
    {"name": "Best Med Spa", "website": "bestmedspa.example", "phone": "2",
     "rating": 4.9, "reviews": 200, "business_status": "OPERATIONAL",

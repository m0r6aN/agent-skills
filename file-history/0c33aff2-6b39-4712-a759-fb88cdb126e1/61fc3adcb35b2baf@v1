    assert rc == 1  # nothing survived
    rows = list(csv.DictReader(open(out, newline="", encoding="utf-8")))
    assert rows == []  # outreach CSV only carries sendable rows


def test_outscraper_polling():
    calls = {"n": 0}

    def handler(request):
        calls["n"] += 1
        if request.url.path.endswith("/maps/search-v2"):
            return httpx.Response(200, json={"results_location": "https://x/results"})
        if calls["n"] < 3:
            return httpx.Response(200, json={"status": "Running"})
        return httpx.Response(200, json={"status": "SUCCESS", "data": [[{"name": "A"}]]})

    client = httpx.Client(transport=httpx.MockTransport(handler))
    out = pipeline.outscraper_search("q", 5, "k", client=client, poll_seconds=0)
    assert out == [{"name": "A"}]
    assert calls["n"] == 3  # trigger + one Running + one SUCCESS


def test_outscraper_auth_is_loud():
    client = httpx.Client(transport=httpx.MockTransport(
        lambda request: httpx.Response(401, text="bad key")))
    with pytest.raises(RuntimeError, match="401"):
        pipeline.outscraper_search("q", 5, "k", client=client, poll_seconds=0)


def test_outscraper_status_is_case_insensitive():
    # Regression 2026-10-01: the live API returns {"status": "Success"}; the old
    # exact-match on "SUCCESS" treated a successful task as failure and raised
    # "Outscraper task failed: Success" on the first live dry run.
    calls = {"n": 0}

    def handler(request):
        calls["n"] += 1
        if request.url.path.endswith("/maps/search-v2"):
            return httpx.Response(200, json={"results_location": "https://x/results"})
        return httpx.Response(200, json={"status": "Success", "data": [[{"name": "A"}]]})

    client = httpx.Client(transport=httpx.MockTransport(handler))
    out = pipeline.outscraper_search("q", 5, "k", client=client, poll_seconds=0)
    assert out == [{"name": "A"}]


def test_outscraper_nonstring_status_is_loud_runtime_error():
    # R11 finding: a non-string status must raise the clean RuntimeError, not AttributeError.
    def handler(request):
        if request.url.path.endswith("/maps/search-v2"):
            return httpx.Response(200, json={"results_location": "https://x/results"})
        return httpx.Response(200, json={"status": {"weird": "shape"}})

    client = httpx.Client(transport=httpx.MockTransport(handler))
    with pytest.raises(RuntimeError, match="task failed"):
        pipeline.outscraper_search("q", 5, "k", client=client, poll_seconds=0)

<#Requires -Version 5.1
<#
.SYNOPSIS
  Host-side poller: turns hub "Run now" requests into schtasks /Run firings.

.DESCRIPTION
  The Automations Admin Hub runs in a Linux container and cannot start Windows
  scheduled tasks itself. When you press "Run now" in the hub, it writes
  <project>\state\run-request.json with { status: "pending", taskName }.
  This script (itself a \MorganFindings\ scheduled task polling every ~2 min)
  scans every immediate subdirectory of the Automations root for pending
  requests and fires schtasks /Run for the recorded taskName, marking the
  request "accepted" (or "error" with the schtasks message so the hub can
  display it).

  Generic by design: any current or future automation works with no changes
  here, as long as (a) the hub registry (hub/server.mjs PROJECTS) lists it
  with its Task Scheduler taskName, (b) that task is registered on the host,
  and (c) its runner appends state/history.jsonl lines with ts_utc (lets the
  hub derive fulfillment; the runners write it to the shared run database,
  db/automations.sqlite). Watcher activity is logged to that database's
  events table (logs/run-watcher.log is only a fallback).

  Register (one time, current user, interactive logon like the other tasks):
    schtasks /Create /TN "\MorganFindings\Automations-RunRequest-Watcher" `
      /TR "powershell.exe -NoProfile -ExecutionPolicy Bypass -File `"D:\Repos\Automations\Watch-RunRequests.ps1`"" `
      /SC MINUTE /MO 2 /IT /F

.EXAMPLE
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File D:\Repos\Automations\Watch-RunRequests.ps1
#>
[CmdletBinding()]
param(
  [string]$DataRoot = ""
)

$ErrorActionPreference = 'Stop'

# NOTE: resolved in the body, not as a param default — automatic variables
# are not reliably populated in param-default scope under all hosts.
if ([string]::IsNullOrWhiteSpace($DataRoot)) {
  $DataRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
}
if ([string]::IsNullOrWhiteSpace($DataRoot)) {
  throw "Cannot determine DataRoot (pass -DataRoot explicitly)."
}

$LogDir = Join-Path $DataRoot 'logs'
$LogFile = Join-Path $LogDir 'run-watcher.log'

$RunDbHelper = Join-Path (Split-Path -Parent $MyInvocation.MyCommand.Path) 'dbRunDb.ps1'
$RunDbReady = $false
try { . $RunDbHelper; $RunDbReady = $true } catch { }

function Write-WatcherLog([string]$Message, [string]$Level = 'info') {
  # Primary sink: the shared run database (events table). The text file is a
  # fallback for when Node/SQLite is unavailable, so logging never breaks the loop.
  try {
    if ($RunDbReady -and (Write-RunDbEvent -Source 'run-watcher' -Level $Level -Message $Message)) { return }
  } catch { }
  try {
    if (-not (Test-Path -LiteralPath $LogDir)) {
      New-Item -ItemType Directory -Path $LogDir -Force | Out-Null
    }
    if ((Test-Path -LiteralPath $LogFile) -and ((Get-Item -LiteralPath $LogFile).Length -gt 100KB)) {
      $old = "$LogFile.old"
      if (Test-Path -LiteralPath $old) { Remove-Item -LiteralPath $old -Force }
      Rename-Item -LiteralPath $LogFile -NewName (Split-Path -Leaf $old) -Force
    }
    "[{0}] {1}" -f ([DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')), $Message |
      Add-Content -LiteralPath $LogFile -Encoding utf8
  } catch {
    # Logging must never break the poll loop.
  }
}

function Set-RequestField($Request, [string]$Name, $Value) {
  if ($Request -is [System.Collections.IDictionary]) {
    $Request[$Name] = $Value
  } else {
    $Request | Add-Member -NotePropertyName $Name -NotePropertyValue $Value -Force
  }
}

$scanned = 0
$acted = 0

foreach ($dir in @(Get-ChildItem -LiteralPath $DataRoot -Directory -ErrorAction SilentlyContinue)) {
  $reqFile = Join-Path $dir.FullName 'state\run-request.json'
  if (-not (Test-Path -LiteralPath $reqFile)) { continue }
  $scanned++

  try {
    $raw = Get-Content -LiteralPath $reqFile -Raw -ErrorAction Stop
    $req = $raw | ConvertFrom-Json -ErrorAction Stop
  } catch {
    Write-WatcherLog -Level warn "SKIP $($dir.Name): unreadable run-request.json ($($_.Exception.Message))"
    continue
  }
  if ($req.status -ne 'pending') { continue }

  $taskName = [string]$req.taskName
  if ([string]::IsNullOrWhiteSpace($taskName)) {
    Set-RequestField $req 'status' 'error'
    Set-RequestField $req 'error' 'request has no taskName; cancel and re-request from the hub'
    $req | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $reqFile -Encoding utf8
    Write-WatcherLog -Level error "ERROR $($dir.Name): missing taskName"
    $acted++
    continue
  }

  # NOTE: schtasks writes failures to stderr, which PowerShell surfaces as
  # error records — under Stop that would abort the loop before the request is
  # marked. Relax preference for this one native call only.
  $prevEAP = $ErrorActionPreference
  $ErrorActionPreference = 'Continue'
  try {
    $out = schtasks /Run /TN $taskName 2>&1 | Out-String
    $code = $LASTEXITCODE
    if ($null -eq $code) { $code = 1 }
  } finally {
    $ErrorActionPreference = $prevEAP
  }
  if ($code -eq 0) {
    Set-RequestField $req 'status' 'accepted'
    Set-RequestField $req 'acceptedAt' ([DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))
    Write-WatcherLog "ACCEPTED $($dir.Name) -> $taskName"
  } else {
    Set-RequestField $req 'status' 'error'
    $detail = ($out | Out-String).Trim()
    if ($detail.Length -gt 500) { $detail = $detail.Substring(0, 500) + '... (truncated)' }
    Set-RequestField $req 'error' "schtasks exit ${code}: $detail"
    Write-WatcherLog -Level error "ERROR $($dir.Name) -> $taskName (exit $code)"
  }
  try {
    $req | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $reqFile -Encoding utf8
  } catch {
    Write-WatcherLog -Level error "ERROR $($dir.Name): cannot write run-request.json ($($_.Exception.Message))"
  }
  $acted++
}

Write-WatcherLog "poll done (scanned $scanned request files, acted on $acted)"

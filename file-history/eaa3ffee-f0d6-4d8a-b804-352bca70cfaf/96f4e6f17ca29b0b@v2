// Shared run/log store for every automation: one local SQLite database
// (db/automations.sqlite) replacing per-project state/history.jsonl, runs/*.md
// capture and logs/ transcripts as the system of record.
//
// Uses node:sqlite (built into Node >= 22.5; no npm dependencies). Rollback
// journal (not WAL) on purpose: the hub container reads this file through a
// Windows bind mount, where WAL's shared-memory file is unreliable.
//
// CLI (used by db/RunDb.ps1; PowerShell 5.1 has no SQLite driver):
//   node rundb.mjs next-run <project>
//   node rundb.mjs record <project> --entry <json-file> [--report <file>] [--log <file>]...
//   node rundb.mjs latest-report <project> [--lines N]
//   node rundb.mjs event <source> <level> <message>
//   node rundb.mjs import [--root <dir>]       (idempotent backfill from files)
//   node rundb.mjs prune [--keep-logs N]
//   node rundb.mjs summary
import { DatabaseSync } from "node:sqlite";
import crypto from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const HERE = path.dirname(fileURLToPath(import.meta.url));
export const DEFAULT_DB = path.join(HERE, "automations.sqlite");
const MAX_TEXT = 4_000_000;
const KEEP_LOGS = 200;

const SCHEMA = `
CREATE TABLE IF NOT EXISTS history (
  id         INTEGER PRIMARY KEY,
  project    TEXT NOT NULL,
  run_no     INTEGER,
  ts_utc     TEXT,
  exit_code  INTEGER,
  result     TEXT,
  entry_json TEXT NOT NULL,
  dedupe_key TEXT NOT NULL,
  UNIQUE (project, dedupe_key)
);
CREATE INDEX IF NOT EXISTS history_project_id ON history (project, id);
CREATE TABLE IF NOT EXISTS reports (
  id      INTEGER PRIMARY KEY,
  project TEXT NOT NULL,
  name    TEXT NOT NULL,
  mtime   TEXT NOT NULL,
  body    TEXT NOT NULL,
  UNIQUE (project, name)
);
CREATE TABLE IF NOT EXISTS logs (
  id      INTEGER PRIMARY KEY,
  project TEXT NOT NULL,
  name    TEXT NOT NULL,
  mtime   TEXT NOT NULL,
  body    TEXT NOT NULL,
  UNIQUE (project, name)
);
CREATE TABLE IF NOT EXISTS events (
  id      INTEGER PRIMARY KEY,
  ts_utc  TEXT NOT NULL,
  source  TEXT NOT NULL,
  level   TEXT NOT NULL,
  message TEXT NOT NULL
);
`;

export function openDb(file = process.env.AUTOMATIONS_DB || DEFAULT_DB) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const db = new DatabaseSync(file);
  db.exec("PRAGMA busy_timeout = 15000; PRAGMA journal_mode = DELETE;");
  db.exec(SCHEMA);
  return db;
}

const sha1 = (s) => crypto.createHash("sha1").update(s).digest("hex");
const nowIso = () => new Date().toISOString().replace(/\.\d+Z$/, "Z");
const clip = (s) => (s.length > MAX_TEXT ? s.slice(0, MAX_TEXT) : s);

function readText(file) {
  let t = fs.readFileSync(file, "utf8");
  if (t.charCodeAt(0) === 0xfeff) t = t.slice(1); // PowerShell 5.1 writes a BOM
  return clip(t);
}

function toIso(v) {
  if (v == null) return null;
  const d = new Date(v);
  return Number.isNaN(d.getTime()) ? null : d.toISOString().replace(/\.\d+Z$/, "Z");
}

function entryColumns(entry) {
  return {
    run_no: Number.isInteger(entry.run) ? entry.run : null,
    ts_utc: toIso(entry.ts_utc ?? entry.ts),
    exit_code: Number.isInteger(entry.exit) ? entry.exit : null,
    result:
      typeof entry.result === "string"
        ? entry.result
        : typeof entry.event === "string"
          ? entry.event
          : null,
  };
}

/** Next run number = rows already recorded for the project + 1 (matches the old line-count rule). */
export function nextRun(db, project) {
  const { n } = db.prepare("SELECT COUNT(*) AS n FROM history WHERE project = ?").get(project);
  return n + 1;
}

export function addHistory(db, project, entry) {
  const json = JSON.stringify(entry);
  const c = entryColumns(entry);
  const r = db
    .prepare(
      `INSERT OR IGNORE INTO history (project, run_no, ts_utc, exit_code, result, entry_json, dedupe_key)
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
    )
    .run(project, c.run_no, c.ts_utc, c.exit_code, c.result, json, sha1(json));
  return Number(r.changes) > 0;
}

function upsertFile(db, table, project, name, mtime, body) {
  db.prepare(
    `INSERT INTO ${table} (project, name, mtime, body) VALUES (?, ?, ?, ?)
     ON CONFLICT (project, name) DO UPDATE SET mtime = excluded.mtime, body = excluded.body`,
  ).run(project, name, mtime, body);
}

export function pruneLogs(db, keep = KEEP_LOGS) {
  db.prepare(
    `DELETE FROM logs WHERE id IN (
       SELECT id FROM (
         SELECT id, ROW_NUMBER() OVER (PARTITION BY project ORDER BY mtime DESC, id DESC) AS rn FROM logs
       ) WHERE rn > ?)`,
  ).run(keep);
}

/** One transaction: history entry + optional report + transcript/prompt logs. */
export function recordRun(db, project, entry, { reports = [], logs = [] } = {}) {
  db.exec("BEGIN IMMEDIATE");
  try {
    addHistory(db, project, entry);
    for (const f of reports) {
      upsertFile(db, "reports", project, path.basename(f), toIso(fs.statSync(f).mtime) ?? nowIso(), readText(f));
    }
    for (const f of logs) {
      upsertFile(db, "logs", project, path.basename(f), toIso(fs.statSync(f).mtime) ?? nowIso(), readText(f));
    }
    pruneLogs(db);
    db.exec("COMMIT");
  } catch (err) {
    db.exec("ROLLBACK");
    throw err;
  }
}

export function latestReport(db, project) {
  return (
    db
      .prepare("SELECT name, mtime, body FROM reports WHERE project = ? ORDER BY mtime DESC, id DESC LIMIT 1")
      .get(project) ?? null
  );
}

export function addEvent(db, source, level, message) {
  db.prepare("INSERT INTO events (ts_utc, source, level, message) VALUES (?, ?, ?, ?)").run(
    nowIso(),
    source,
    level,
    String(message).slice(0, 8000),
  );
  // Keep the event log bounded (it replaced a size-rotated text log).
  db.exec("DELETE FROM events WHERE id <= (SELECT MAX(id) FROM events) - 5000");
}

/** Idempotent backfill from the legacy files under <root>/<project>/. */
export function importAll(db, root) {
  const stats = { history: 0, reports: 0, logs: 0, projects: [] };
  for (const d of fs.readdirSync(root, { withFileTypes: true })) {
    if (!d.isDirectory() || d.name.startsWith(".")) continue;
    const dir = path.join(root, d.name);
    const hist = path.join(dir, "state", "history.jsonl");
    const runs = path.join(dir, "runs");
    const logs = path.join(dir, "logs");
    // Only automation projects (they have run history or captured reports).
    if (![hist, runs].some((p) => fs.existsSync(p))) continue;
    stats.projects.push(d.name);
    db.exec("BEGIN IMMEDIATE");
    try {
      if (fs.existsSync(hist)) {
        for (const line of readText(hist).split(/\r?\n/)) {
          const t = line.trim();
          if (!t) continue;
          let entry;
          try {
            entry = JSON.parse(t);
          } catch {
            entry = { _raw: t.slice(0, 500) };
          }
          if (addHistory(db, d.name, entry)) stats.history++;
        }
      }
      if (fs.existsSync(runs)) {
        for (const f of fs.readdirSync(runs)) {
          if (!f.endsWith(".md") || f === "latest.md") continue; // latest is derived
          const p = path.join(runs, f);
          upsertFile(db, "reports", d.name, f, toIso(fs.statSync(p).mtime), readText(p));
          stats.reports++;
        }
      }
      if (fs.existsSync(logs)) {
        for (const f of fs.readdirSync(logs)) {
          const p = path.join(logs, f);
          if (!fs.statSync(p).isFile()) continue;
          upsertFile(db, "logs", d.name, f, toIso(fs.statSync(p).mtime), readText(p));
          stats.logs++;
        }
      }
      db.exec("COMMIT");
    } catch (err) {
      db.exec("ROLLBACK");
      throw err;
    }
  }
  pruneLogs(db);
  return stats;
}

// ---- CLI ----
function parseArgs(argv) {
  const pos = [];
  const opt = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      const k = a.slice(2);
      const v = argv[++i];
      (opt[k] ??= []).push(v);
    } else pos.push(a);
  }
  return { pos, opt };
}

function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  const { pos, opt } = parseArgs(rest);
  const db = openDb();
  try {
    switch (cmd) {
      case "next-run":
        console.log(nextRun(db, pos[0]));
        break;
      case "record": {
        const entry = JSON.parse(readText(opt.entry[0]));
        recordRun(db, pos[0], entry, {
          reports: (opt.report ?? []).filter((f) => fs.existsSync(f)),
          logs: (opt.log ?? []).filter((f) => fs.existsSync(f)),
        });
        console.log("recorded");
        break;
      }
      case "latest-report": {
        const r = latestReport(db, pos[0]);
        if (!r) process.exit(3);
        const n = opt.lines ? Number(opt.lines[0]) : 0;
        process.stdout.write(n > 0 ? r.body.split(/\r?\n/).slice(0, n).join("\n") : r.body);
        break;
      }
      case "event":
        addEvent(db, pos[0], pos[1], pos.slice(2).join(" "));
        break;
      case "import":
        console.log(JSON.stringify(importAll(db, opt.root?.[0] ?? path.dirname(HERE))));
        break;
      case "prune":
        pruneLogs(db, opt["keep-logs"] ? Number(opt["keep-logs"][0]) : KEEP_LOGS);
        break;
      case "summary":
        console.log(
          JSON.stringify(
            db.prepare("SELECT project, COUNT(*) AS runs, MAX(ts_utc) AS last FROM history GROUP BY project").all(),
            null,
            2,
          ),
        );
        break;
      default:
        console.error("usage: rundb.mjs next-run|record|latest-report|event|import|prune|summary");
        process.exit(2);
    }
  } finally {
    db.close();
  }
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  try {
    main();
  } catch (err) {
    console.error(String(err?.stack ?? err));
    process.exit(1);
  }
}

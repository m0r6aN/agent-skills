# Harness runtime state and test caches — never repo content.
# projects/, sessions/, .oauth_refresh.lock.owner: the agent harness writes its
# global project/session state root into the CWD; it holds other projects'
# session transcripts and live session keys.
# .claude.json, .credentials.json, settings.json, history.jsonl,
# mcp-needs-auth-cache.json, .last-*, backups/, cache/, daemon/, file-history/,
# shell-snapshots/, jobs/, teams/: harness config, caches and live key material
# (daemon/*.key, sessions/*.key) swept into the rescue commit on 2026-10-04;
# untracked in the strip commit and ignored here so they never ride a
# git add -A again. Treat anything that reached the remote as exposed.
# plugins/cache: regenerable plugin-install test cache (~109k files).
# skills/accomplish-workspace: stale (2026-06-16) external skill-eval run that
# was relocated into this tree; preserved on disk, not this repo's content.
/.oauth_refresh.lock.owner
/sessions/
/projects/
/plugins/cache/
/skills/accomplish-workspace/
/.claude.json
/.credentials.json
/settings.json
/history.jsonl
/mcp-needs-auth-cache.json
/.last-cleanup
/.last-update-result.json
/backups/
/cache/
/daemon/
/file-history/
/shell-snapshots/
/jobs/
/teams/

# Untracked 2026-10-08 (ci-fail-fast hygiene): harness trash + pi plugin sync state.
# Both were accidentally committed (7403 + 2351 files); nothing consumes them
# (spec-linter/grandfather.test.ts excludes both trees explicitly).
plugins/.trash/
plugins/synced/

# Untracked 2026-10-11 (control-center shaping, first FCA-P3 worktree-hygiene
# fix): ops-console runtime state stores. Written by the console at run time
# (FOC-P3/OQ3 closed vocabulary: notifications.json, invocation-audit.json);
# the tracked copy churned the working tree on every run. Local copies kept.
plugins/foreman-line/ops-console/state/


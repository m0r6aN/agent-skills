{
  "name": "@foreman-line/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Frozen pipeline stage contracts for the Foreman Line (W0-P1): TypeScript types + JSON Schemas for the six-stage pipeline (A->F).",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "tsx src/generate.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}

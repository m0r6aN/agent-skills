{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foreman-line.local/schemas/kernel-contracts/authorize-action-input.schema.json",
  "$defs": {
    "AuthorizeActionInput": {
      "type": "object",
      "properties": {
        "callerInputs": {
          "type": "object",
          "properties": {
            "lifecycleEvent": {
              "$ref": "lifecycle-event.schema.json#/$defs/LifecycleEvent"
            }
          },
          "required": [
            "lifecycleEvent"
          ],
          "additionalProperties": false
        },
        "trustedBindings": {
          "type": "object",
          "properties": {
            "admittedContext": {
              "$ref": "admitted-context.schema.json#/$defs/AdmittedContext"
            },
            "lifecycleProvenance": {
              "type": "object",
              "properties": {
                "provenanceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "hostAdapterRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "provenanceDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "provenanceId",
                "hostAdapterRef",
                "provenanceDigest"
              ],
              "additionalProperties": false
            },
            "effectiveActionClass": {
              "$ref": "#/$defs/EffectiveActionClass"
            },
            "repositoryIdentity": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "repositoryRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "worktreeRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "required": [
                "repositoryRef",
                "worktreeRef"
              ],
              "additionalProperties": false
            },
            "policyDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "scopeDigest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "goalRevision": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "leaseState": {
              "$ref": "#/$defs/LeaseCasDescriptor"
            },
            "gateEvidenceRefs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GitGateEvidenceRef"
              },
              "maxItems": 64
            },
            "mode": {
              "enum": [
                "shadow",
                "enforcing",
                "degraded-read-only"
              ]
            },
            "observedEffects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ObservedEffect"
              },
              "maxItems": 64
            },
            "idempotencyKey": {
              "oneOf": [
                {
                  "$ref": "decision-envelope.schema.json#/$defs/IdempotencyBinding"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "admittedContext",
            "lifecycleProvenance",
            "effectiveActionClass",
            "repositoryIdentity",
            "policyDigest",
            "scopeDigest",
            "goalRevision",
            "leaseState",
            "gateEvidenceRefs",
            "mode",
            "observedEffects",
            "idempotencyKey"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "callerInputs",
        "trustedBindings"
      ],
      "additionalProperties": false
    },
    "EffectiveActionClass": {
      "enum": [
        "read-only",
        "governed-mutation",
        "mutation-capable",
        "lifecycle-only"
      ]
    },
    "PolicyIdentity": {
      "type": "object",
      "properties": {
        "policyIdentityVersion": {
          "const": "0.1.0"
        },
        "registry": {
          "type": "object",
          "properties": {
            "registryId": {
              "const": "foreman-kernel-authority-enforcement"
            },
            "schemaVersion": {
              "const": "0.1.0"
            },
            "sourceSnapshotCommit": {
              "type": "string"
            },
            "registryContentDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "registryId",
            "schemaVersion",
            "sourceSnapshotCommit",
            "registryContentDigest"
          ],
          "additionalProperties": false
        },
        "effectivePolicyDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effectiveConfigurationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "policyIdentityVersion",
        "registry",
        "effectivePolicyDigest",
        "effectiveConfigurationDigest"
      ],
      "additionalProperties": false
    },
    "LeaseCasDescriptor": {
      "type": "object",
      "properties": {
        "leaseId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "leaseOwnerPrincipalRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "casRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "leaseExpiresAtMicros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "leaseId",
        "leaseOwnerPrincipalRef",
        "casRevision",
        "leaseExpiresAtMicros"
      ],
      "additionalProperties": false
    },
    "GitGateEvidenceRef": {
      "type": "object",
      "properties": {
        "evidenceKind": {
          "enum": [
            "commit-ref",
            "signature",
            "status-check",
            "merge-record"
          ]
        },
        "gitIdentity": {
          "type": "string",
          "maxLength": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "evidenceKind",
        "gitIdentity",
        "digest"
      ],
      "additionalProperties": false
    },
    "ObservedEffect": {
      "type": "object",
      "properties": {
        "effectKind": {
          "enum": [
            "diff",
            "file-write",
            "file-delete",
            "process-exit",
            "unknown"
          ]
        },
        "descriptor": {
          "type": "string",
          "maxLength": 4096
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "effectKind",
        "descriptor",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "foreman-line.kernel-import.import-epoch",
  "title": "FK-P11 cutover epoch record (T4/T8)",
  "description": "Machine-readable companion to the import.epoch event payload / EpochRecord shape. Carried by one import.epoch event plus one artifacts row; keyed by lineage root. The code validator (src/import.ts normalizeEpochPayload) is the runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "epochId",
    "rootCommit",
    "tipCommit",
    "documentDigest",
    "corpusDigest",
    "corpusSourceRevision",
    "rowCount",
    "principalRef",
    "operationId",
    "toolVersion",
    "recordedAtMicros"
  ],
  "properties": {
    "epochId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rootCommit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "tipCommit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "documentDigest": { "$ref": "#/$defs/Digest" },
    "corpusDigest": { "$ref": "#/$defs/Digest" },
    "corpusSourceRevision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "rowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "principalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "recordedAtMicros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

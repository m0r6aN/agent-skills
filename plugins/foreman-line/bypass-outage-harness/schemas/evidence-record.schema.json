{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "foreman-line.bypass-outage-harness/evidence-record",
  "title": "FK-P17′ case evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "kind",
    "vectorClass",
    "className",
    "channel",
    "scenario",
    "exercised",
    "status",
    "classification",
    "classificationBasis",
    "collateral",
    "mechanismPolicyClass",
    "refusalSource",
    "hypothesis",
    "hypothesisFalsified",
    "guardInvocation",
    "observed",
    "invocationLedger",
    "effectEvidence",
    "artifacts",
    "gapRecord",
    "obligations",
    "notes"
  ],
  "properties": {
    "caseId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["vector", "control", "measurement"] },
    "vectorClass": { "type": ["string", "null"] },
    "className": { "type": ["string", "null"] },
    "channel": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "exercised": { "enum": ["yes", "gap"] },
    "status": { "enum": ["exercised", "not-exercised"] },
    "classification": { "enum": ["mechanical", "detected", "unsupported", null] },
    "classificationBasis": { "type": "string", "minLength": 1 },
    "collateral": { "type": "boolean" },
    "mechanismPolicyClass": { "enum": ["model-membership", "scope", "none"] },
    "refusalSource": { "enum": ["model-gate", "mutation-scope-guard", null] },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "basis"],
      "properties": {
        "classification": { "enum": ["mechanical", "detected", "unsupported", null] },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "hypothesisFalsified": { "type": "boolean" },
    "guardInvocation": { "type": "boolean" },
    "observed": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "refusalObserved",
        "effectLanded",
        "detectionObserved",
        "refusalSource",
        "collateralObserved"
      ],
      "properties": {
        "refusalObserved": { "type": "boolean" },
        "effectLanded": { "type": "boolean" },
        "detectionObserved": { "type": "boolean" },
        "refusalSource": { "enum": ["model-gate", "mutation-scope-guard", null] },
        "collateralObserved": { "type": "boolean" }
      }
    },
    "invocationLedger": { "type": "array", "items": { "type": "string" } },
    "effectEvidence": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "gapRecord": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "reason", "obligation"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "obligation": { "type": "string", "minLength": 1 }
      }
    },
    "obligations": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}

{
  "name": "@foreman-line/authority-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Source-bound Foreman Kernel authority and enforcement registry contract.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "foreman-authority-registry": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "tsx src/generate.ts",
    "test": "node --input-type=commonjs -e \"const{spawnSync}=require('child_process'),fs=require('fs');let failed=[];for(const f of fs.readdirSync('tests').filter(n=>n.endsWith('.test.ts')).sort()){const r=spawnSync(process.execPath,['node_modules/tsx/dist/cli.mjs','--test','--test-reporter=tap','--test-concurrency=1','tests/'+f],{stdio:'inherit'});if(r.status!==0)failed.push(f);}if(failed.length){console.error('FAILED FILES: '+failed.join(', '));process.exit(1);}\"",
    "lint": "biome check .",
    "test:all-in-one": "tsx --test --test-reporter=tap --test-concurrency=1 tests/*.test.ts",
    "test:file": "tsx --test --test-reporter=tap --test-concurrency=1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "26.1.1",
    "tsx": "4.23.1"
  }
}

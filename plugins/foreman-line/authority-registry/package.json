    "test": "tsx --test tests/*.test.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "26.1.1",
    "tsx": "4.23.1"
  }
}

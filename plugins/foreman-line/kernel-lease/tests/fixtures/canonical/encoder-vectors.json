{
  "records": [
    {
      "id": "VEC-01-key-order-utf16",
      "rule": "member order: UTF-16 code-unit sort at every depth",
      "value": {
        "b": 1,
        "a": 2,
        "B": 3,
        "_": 4,
        "nested": {
          "z": 1,
          "A": 2,
          "é": 3
        }
      },
      "expected": "{\"B\":3,\"_\":4,\"a\":2,\"b\":1,\"nested\":{\"A\":2,\"z\":1,\"é\":3}}"
    },
    {
      "id": "VEC-02-array-order",
      "rule": "array order preserved exactly",
      "value": {
        "list": [
          3,
          1,
          2,
          0
        ]
      },
      "expected": "{\"list\":[3,1,2,0]}"
    },
    {
      "id": "VEC-03-escape-set",
      "rule": "exactly the JSON.stringify escape set",
      "value": {
        "s": "quote\" back\\slash\u0000\u001f tab\tnl\n"
      },
      "expected": "{\"s\":\"quote\\\" back\\\\slash\\u0000\\u001f tab\\u0009nl\\u000a\"}"
    },
    {
      "id": "VEC-04-digits-only-integers",
      "rule": "digits-only integer lexemes; unsafe/fraction/negative rejected",
      "value": {
        "zero": 0,
        "ten": 10,
        "max": 9007199254740991
      },
      "expected": "{\"max\":9007199254740991,\"ten\":10,\"zero\":0}",
      "rejects": [
        {
          "value": {
            "n": -1
          }
        },
        {
          "value": {
            "n": 1.5
          }
        },
        {
          "value": {
            "n": -0
          }
        },
        {
          "value": {
            "n": 9007199254740992
          }
        },
        {
          "value": {
            "n": 1e+21
          }
        }
      ]
    },
    {
      "id": "VEC-05-unicode-non-normalization",
      "rule": "no Unicode normalization of keys or values",
      "value": {
        "composed": "é",
        "decomposed": "é"
      },
      "expected": "{\"composed\":\"é\",\"decomposed\":\"é\"}"
    },
    {
      "id": "VEC-06-no-path-case-folding",
      "rule": "no path case folding anywhere in hashing",
      "value": {
        "path": "D:\\Work\\Repo\\Src"
      },
      "expected": "{\"path\":\"D:\\\\Work\\\\Repo\\\\Src\"}",
      "distinct": {
        "path": "D:\\work\\repo\\src"
      }
    },
    {
      "id": "VEC-07-empty-containers",
      "rule": "empty containers preserved",
      "value": {
        "obj": {},
        "arr": [],
        "str": ""
      },
      "expected": "{\"arr\":[],\"obj\":{},\"str\":\"\"}"
    },
    {
      "id": "VEC-08-unpaired-surrogate-rejection",
      "rule": "unpaired Unicode surrogates rejected",
      "value": {
        "s": "ok"
      },
      "expected": "{\"s\":\"ok\"}",
      "rejects": [
        {
          "value": {
            "s": "\ud800"
          }
        },
        {
          "value": {
            "s": "\udc00"
          }
        }
      ]
    }
  ]
}

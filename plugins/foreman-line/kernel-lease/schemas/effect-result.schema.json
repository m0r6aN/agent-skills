{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "foreman-line.kernel-lease/effect-result.schema.json",
  "title": "EffectResult (FK-P1 F05.11 verbatim; decision/code pairing invariant)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resultKind",
    "apiVersion",
    "toolVersion",
    "decision",
    "code",
    "idempotencyKey",
    "effectDigest",
    "goalRevision"
  ],
  "properties": {
    "resultKind": { "const": "effect-result" },
    "apiVersion": { "const": "0.1.0" },
    "toolVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x00-\\x7f]+$"
    },
    "decision": { "enum": ["APPLIED", "NOOP"] },
    "code": { "enum": ["EFFECT_APPLIED", "EFFECT_NOOP"] },
    "idempotencyKey": { "$ref": "#/$defs/IdempotencyBinding" },
    "effectDigest": {
      "oneOf": [{ "$ref": "#/$defs/Digest" }, { "type": "null" }]
    },
    "goalRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "IdempotencyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalRef", "operationId", "repositoryRef", "worktreeRef", "payloadDigest"],
      "properties": {
        "principalRef": { "$ref": "#/$defs/Id" },
        "operationId": { "$ref": "#/$defs/Id" },
        "repositoryRef": { "$ref": "#/$defs/Id" },
        "worktreeRef": { "$ref": "#/$defs/Id" },
        "payloadDigest": { "$ref": "#/$defs/Digest" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "APPLIED" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "code": { "const": "EFFECT_APPLIED" },
          "effectDigest": { "$ref": "#/$defs/Digest" }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "NOOP" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "code": { "const": "EFFECT_NOOP" },
          "effectDigest": { "type": "null" }
        }
      }
    }
  ]
}

            }
          },
          "required": [
            "event",
            "apiVersion",
            "eventId",
            "sessionRef",
            "hostAdapterRef",
            "claimedRepositoryRef",
            "claimedWorktreeRef",
            "actionRef",
            "claimedActionClass",
            "payload"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProposedPath": {
      "type": "object",
      "properties": {
        "rawPath": {
          "type": "string",
          "maxLength": 4096
        },
        "pathForm": {
          "enum": [
            "windows-drive",
            "windows-unc",
            "posix-absolute",
            "other"
          ]
        }
      },
      "required": [
        "rawPath",
        "pathForm"
      ],
      "additionalProperties": false
    },
    "SessionStartPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "PreToolUsePayload": {
      "type": "object",
      "properties": {
        "toolRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "proposedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposedPath"
          },
          "maxItems": 64
        }
      },
      "required": [
        "toolRef",
        "proposedPaths"
      ],
      "additionalProperties": false
    },
    "PostToolUsePayload": {
      "type": "object",
      "properties": {
        "toolRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "observedEffects": {
          "type": "array",
          "items": {
            "$ref": "authorize-action-input.schema.json#/$defs/ObservedEffect"
          },
          "maxItems": 64
        }
      },
      "required": [
        "toolRef",
        "observedEffects"
      ],
      "additionalProperties": false
    },
    "StopPayload": {
      "type": "object",
      "properties": {
        "requestedCompletionSubject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "requestedCompletionSubject"
      ],
      "additionalProperties": false
    }
  }
}

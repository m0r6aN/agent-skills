                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "claimedWorktreeRef": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "actionRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "claimedActionClass": {
              "enum": [
                "read-only",
                "governed-mutation",
                "opaque-mutation-capable",
                "lifecycle-only"
              ]
            },
            "payload": {
              "$ref": "#/$defs/PreToolUsePayload"
            }
          },
          "required": [
            "event",
            "apiVersion",
            "eventId",
            "sessionRef",
            "hostAdapterRef",
            "claimedRepositoryRef",
            "claimedWorktreeRef",
            "actionRef",
            "claimedActionClass",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "postToolUse"
            },
            "apiVersion": {
              "const": "0.1.0"
            },
            "eventId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "sessionRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "hostAdapterRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "claimedRepositoryRef": {
              "type": [
                "string",
                "null"
              ],

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foreman-line.local/schemas/kernel-contracts/repository-read-request.schema.json",
  "$defs": {
    "ReadRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "readKind": {
              "const": "content-only"
            },
            "content": {
              "type": "string",
              "maxLength": 65536
            },
            "contentEncoding": {
              "const": "utf-8"
            }
          },
          "required": [
            "readKind",
            "content",
            "contentEncoding"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "readKind": {
              "const": "repository-read"
            },
            "repoId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "relativePath": {
              "type": "string",
              "maxLength": 4096
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          },
          "required": [
            "readKind",
            "repoId",
            "relativePath",
            "maxBytes"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

    {
      "id": "LINK-08",
      "linkKind": "race",
      "tree": [
        {
          "op": "file",
          "path": "target.txt",
          "content": "original"
        },
        {
          "op": "outside-file",
          "path": "outside/racer.txt",
          "content": "racer"
        }
      ],
      "verify": [
        "target.txt"
      ],
      "expectedCode": "LINK_TARGET_RACE",
      "race": {
        "steps": [
          "verifyCompiledPaths captures target.txt identity",
          "attacker unlinks target.txt and writes a replacement file at the same path (substitution)",
          "consumer opens target.txt (the opened handle holds the replacement)",
          "attacker swaps back: unlink and write a fresh copy at the path (double swap — a path re-check would now pass)",
          "reverifyOpenedTarget(fd, captured) compares the OPENED handle identity and throws LINK_TARGET_RACE"
        ]
      },
      "repair": "no substitution; reverifyOpenedTarget passes"
    }
  ]

{
  "schema": "spec-body-compiler/link-trees/v1",
  "note": "H4 symlink/reparse escape. Trees are materialized at test time under a fresh root. linkKind junction MUST execute (chain hard-fails otherwise, OQ-5a); linkKind file/dir are privilege-classed symlink cases that may skip ONLY with a machine-readable gap record (OQ-5b, never counted as passed). LINK-08 is the opened-target substitution race descriptor (no symlink required).",
  "cases": [
    {
      "id": "LINK-01",
      "linkKind": "file",
      "tree": [
        {
          "op": "outside-file",
          "path": "outside/secret.txt",
          "content": "secret"
        },
        {
          "op": "link",
          "path": "evil.txt",
          "target": "../outside/secret.txt",
          "linkKind": "file"
        }
      ],
      "verify": [
        "evil.txt"
      ],
      "expectedCode": "LINK_ESCAPE",
      "repair": "replace the link with a plain file"
    },
    {
      "id": "LINK-02",
      "linkKind": "dir",
      "tree": [
        {
          "op": "outside-dir",
          "path": "outside-dir"
        },
        {
          "op": "outside-file",
          "path": "outside-dir/x.txt",
          "content": "x"
        },
        {
          "op": "link",
          "path": "evildir",
          "target": "../outside-dir",
          "linkKind": "dir"
        }
      ],
      "verify": [
        "evildir/x.txt"
      ],
      "expectedCode": "LINK_ESCAPE",
      "repair": "replace the link with a real directory"
    },
    {
      "id": "LINK-03",

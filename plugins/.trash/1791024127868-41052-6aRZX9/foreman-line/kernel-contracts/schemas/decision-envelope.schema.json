{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foreman-line.local/schemas/kernel-contracts/decision-envelope.schema.json",
  "$defs": {
    "WireCode": {
      "enum": [
        "WORKTREE_MISMATCH",
        "BRANCH_MISMATCH",
        "PATH_OUTSIDE_ALLOWED_FILES",
        "FROZEN_SURFACE_MUTATION",
        "REVIEWER_MUTATION_FORBIDDEN",
        "REVIEW_WORKTREE_DIRTY",
        "POLICY_SELF_MODIFICATION",
        "MEDIATED_BYPASS_MODE_FORBIDDEN",
        "OWNER_LEASE_MISMATCH",
        "STATE_REVISION_STALE",
        "GATE_NOT_SATISFIED",
        "SESSION_ENROLLMENT_MISSING",
        "INVALID_REQUEST",
        "UNSUPPORTED_VERSION",
        "PAYLOAD_LIMIT_EXCEEDED",
        "ADMISSION_REQUIRED",
        "CAPABILITY_SCOPE_MISMATCH",
        "READ_BOUNDARY_VIOLATION",
        "KERNEL_INTERNAL_FAILURE",
        "KERNEL_UNREACHABLE",
        "IDEMPOTENCY_CONFLICT",
        "POLICY_ALLOW",
        "POLICY_ADVISORY",
        "POLICY_RESOLUTION_UNRESOLVED",
        "POLICY_PROJECTION_UNMAPPED",
        "HUMAN_JUDGMENT_REQUIRED",
        "EFFECT_APPLIED",
        "EFFECT_NOOP"
      ]
    },
    "DecisionEnvelope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "resultKind": {
              "const": "policy-result"
            },
            "apiVersion": {
              "const": "0.1.0"
            },
            "toolVersion": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[\\x00-\\x7F]*$"
            },
            "code": {
              "$ref": "#/$defs/WireCode"
            },
            "violations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Violation"
              },
              "maxItems": 64
            },
            "requestDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "policyDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "principal": {
              "$ref": "#/$defs/PrincipalProjection"
            },
            "assurance": {
              "$ref": "#/$defs/AssuranceClaim"
            },
            "obligations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Obligation"
              },
              "maxItems": 64
            },
            "goalRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "policyEvidence": {
              "oneOf": [
                {
                  "$ref": "#/$defs/UpstreamPolicyEvidence"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mode": {
              "enum": [
                "enforcing",
                "degraded-read-only"
              ]
            },
            "decision": {
              "enum": [
                "ALLOW",
                "REFUSE",
                "ADVISORY",
                "CONFLICT",
                "REQUIRE_HUMAN"
              ]
            }
          },
          "required": [
            "resultKind",
            "apiVersion",
            "toolVersion",
            "code",
            "violations",
            "requestDigest",
            "inputDigest",
            "policyDigest",
            "principal",
            "assurance",
            "obligations",
            "policyEvidence",
            "mode",
            "decision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "resultKind": {
              "const": "policy-result"
            },
            "apiVersion": {
              "const": "0.1.0"
            },
            "toolVersion": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[\\x00-\\x7F]*$"
            },
            "code": {
              "$ref": "#/$defs/WireCode"
            },
            "violations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Violation"
              },
              "maxItems": 64
            },
            "requestDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "policyDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "principal": {
              "$ref": "#/$defs/PrincipalProjection"
            },
            "assurance": {
              "$ref": "#/$defs/AssuranceClaim"
            },
            "obligations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Obligation"
              },
              "maxItems": 64
            },
            "goalRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "policyEvidence": {
              "oneOf": [
                {
                  "$ref": "#/$defs/UpstreamPolicyEvidence"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mode": {
              "const": "shadow"
            },
            "decision": {
              "const": "ADVISORY"
            },
            "wouldDecision": {
              "enum": [
                "ALLOW",
                "REFUSE",
                "ADVISORY",
                "CONFLICT",
                "REQUIRE_HUMAN"
              ]
            }
          },
          "required": [
            "resultKind",
            "apiVersion",
            "toolVersion",
            "code",
            "violations",
            "requestDigest",
            "inputDigest",
            "policyDigest",
            "principal",
            "assurance",
            "obligations",
            "policyEvidence",
            "mode",
            "decision",
            "wouldDecision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PrincipalProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "principalClass": {
              "enum": [
                "coordinator",
                "shaper",
                "builder",
                "human-developer",
                "independent-reviewer",
                "ci-service",
                "host-adapter",
                "kernel-operator"
              ]
            },
            "principalRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "required": [
            "principalClass",
            "principalRef"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "principalClass": {
              "const": "anonymous-read"
            }
          },
          "required": [
            "principalClass"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProtocolError": {
      "type": "object",
      "properties": {
        "resultKind": {
          "const": "protocol-error"
        },
        "protocolCode": {
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_VERSION",
            "PAYLOAD_LIMIT_EXCEEDED",
            "ADMISSION_REQUIRED",
            "CAPABILITY_SCOPE_MISMATCH",
            "READ_BOUNDARY_VIOLATION",
            "KERNEL_INTERNAL_FAILURE"
          ]
        },
        "safeDiagnostic": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[\\x00-\\x7F]*$"
        },
        "correlationRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "apiVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "toolVersion": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[\\x00-\\x7F]*$"
        }
      },
      "required": [
        "resultKind",
        "protocolCode",
        "safeDiagnostic",
        "correlationRef",
        "apiVersion",
        "toolVersion"
      ],
      "additionalProperties": false
    },
    "UpstreamPolicyEvidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "const": "RESOLVED"
            },
            "subject": {
              "type": "string"
            },
            "claim": {
              "type": "string"
            },
            "decision": {
              "enum": [
                "ALLOW",
                "REFUSE",
                "ADVISORY",
                "REQUIRE_HUMAN"
              ]
            },
            "classification": {
              "enum": [
                "pre-action-refusal",
                "post-action-detection",
                "ci-static-check",
                "independent-review-human-judgment",
                "narrative-provenance",
                "unsupported"
              ]
            },
            "assurance": {
              "enum": [
                "narrative",
                "structural",
                "detected",
                "mediated",
                "independently-verified",
                "human-ratified"
              ]
            },
            "enforcementOwner": {
              "enum": [
                "human-developer",
                "human-merge-operator",
                "coordinator",
                "kernel-policy",
                "host-adapter",
                "ci",
                "independent-reviewer",
                "provenance-only",
                "none"
              ]
            },
            "severity": {
              "enum": [
                "info",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "controllingRuleIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "maxItems": 64
            },
            "consideredRuleIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "maxItems": 64
            }
          },
          "required": [
            "outcome",
            "subject",
            "claim",
            "decision",
            "classification",
            "assurance",
            "enforcementOwner",
            "severity",
            "controllingRuleIds",
            "consideredRuleIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "const": "REQUIRE_HUMAN"
            },
            "subject": {
              "type": "string"
            },
            "reasonCode": {
              "enum": [
                "REGISTRY_INVALID",
                "INVALID_QUERY_SCOPE",
                "NO_APPLICABLE_AUTHORITY"
              ]
            },
            "controllingRuleIds": {
              "const": []
            },
            "consideredRuleIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "maxItems": 64
            }
          },
          "required": [
            "outcome",
            "subject",
            "reasonCode",
            "controllingRuleIds",
            "consideredRuleIds"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AssuranceClaim": {
      "type": "object",
      "properties": {
        "assuranceLevel": {
          "enum": [
            "structural",
            "mediated",
            "detected-only",
            "ci-enforced",
            "human-judgment",
            "unsupported-host",
            "degraded-read-only"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssuranceEvidenceRef"
          },
          "maxItems": 8
        },
        "missingAssuranceReason": {
          "oneOf": [
            {
              "enum": [
                "evidence-not-yet-produced",
                "producer-out-of-scope",
                "evidence-unavailable",
                "degraded-posture"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assuranceLevel",
        "evidence",
        "missingAssuranceReason"
      ],
      "additionalProperties": false
    },
    "AssuranceEvidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "checkId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "fixtureDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "checkId",
            "fixtureDigest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "hostAdapterRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "runDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "runId",
            "hostAdapterRef",
            "runDigest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "detectorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "detectionDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "detectorId",
            "detectionDigest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "workflowRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "runDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "workflowRef",
            "runDigest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gateArtifactRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "gitEvidenceDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "gateArtifactRef",
            "gitEvidenceDigest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "probeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "probeDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "probeId",
            "probeDigest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "postureEventId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "postureDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "postureEventId",
            "postureDigest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EffectResult": {
      "type": "object",
      "properties": {
        "resultKind": {
          "const": "effect-result"
        },
        "apiVersion": {
          "const": "0.1.0"
        },
        "toolVersion": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[\\x00-\\x7F]*$"
        },
        "decision": {
          "enum": [
            "APPLIED",
            "NOOP"
          ]
        },
        "code": {
          "enum": [
            "EFFECT_APPLIED",
            "EFFECT_NOOP"
          ]
        },
        "idempotencyKey": {
          "$ref": "#/$defs/IdempotencyBinding"
        },
        "effectDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "goalRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "resultKind",
        "apiVersion",
        "toolVersion",
        "decision",
        "code",
        "idempotencyKey",
        "effectDigest",
        "goalRevision"
      ],
      "additionalProperties": false
    },
    "IdempotencyBinding": {
      "type": "object",
      "properties": {
        "principalRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "repositoryRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "worktreeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "principalRef",
        "operationId",
        "repositoryRef",
        "worktreeRef",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "Violation": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/WireCode"
        },
        "invariantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "path": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._\\-/\\[\\]]+$"
        }
      },
      "required": [
        "code",
        "invariantId",
        "path"
      ],
      "additionalProperties": false
    },
    "Obligation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "obligationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "kind": {
              "const": "post-diff-inspection"
            },
            "payload": {
              "type": "object",
              "properties": {
                "scopeDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "scopeDigest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "obligationId",
            "kind",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "obligationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "kind": {
              "const": "fresh-scm-evidence"
            },
            "payload": {
              "type": "object",
              "properties": {
                "evidenceKind": {
                  "enum": [
                    "commit-ref",
                    "signature",
                    "status-check"
                  ]
                },
                "maxEvidenceAgeMicros": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "evidenceKind",
                "maxEvidenceAgeMicros"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "obligationId",
            "kind",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "obligationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "kind": {
              "const": "stop-report-emission"
            },
            "payload": {
              "type": "object",
              "properties": {
                "transitionDescription": {
                  "type": "string",
                  "maxLength": 4096
                },
                "awaitingHuman": {
                  "const": true
                }
              },
              "required": [
                "transitionDescription",
                "awaitingHuman"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "obligationId",
            "kind",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "obligationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "kind": {
              "const": "degraded-read-logging"
            },
            "payload": {
              "type": "object",
              "properties": {
                "degradedReason": {
                  "enum": [
                    "kernel-unreachable",
                    "decision-deadline-exceeded",
                    "outage-mode"
                  ]
                }
              },
              "required": [
                "degradedReason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "obligationId",
            "kind",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "obligationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "kind": {
              "const": "latency-recording"
            },
            "payload": {
              "type": "object",
              "properties": {
                "span": {
                  "enum": [
                    "kernelDecisionLatency",
                    "mediatedActionLatency",
                    "firstCallObservation"
                  ]
                },
                "elapsedMicros": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "budgetMicros": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "span",
                "elapsedMicros",
                "budgetMicros"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "obligationId",
            "kind",
            "payload"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

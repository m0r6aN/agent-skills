              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "stringEvidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "evidenceRef"
              ],
              "properties": {
                "status": {
                  "const": "recorded"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "evidenceRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            }
          ]
        },
        "booleanEvidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value",
                "evidenceRef"
              ],
              "properties": {
                "status": {
                  "const": "recorded"
                },
                "value": {
                  "type": "boolean"
                },
                "evidenceRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }

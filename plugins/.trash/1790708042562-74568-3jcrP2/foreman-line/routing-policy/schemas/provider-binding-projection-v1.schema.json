            "foremanRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "piRuntimeVersion": {
              "$ref": "#/$defs/stringEvidence"
            },
            "acquiredAtUtc": {
              "$ref": "#/$defs/stringEvidence"
            },
            "evidenceState": {
              "enum": [
                "static-conformance",
                "live-availability",
                "model-quality"
              ]
            },
            "freshnessAcceptance": {
              "enum": [
                "not-accepted",
                "owner-accepted"
              ]
            }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data_collection",
            "zdr"

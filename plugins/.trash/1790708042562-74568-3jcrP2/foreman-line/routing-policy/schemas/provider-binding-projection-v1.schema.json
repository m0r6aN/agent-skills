        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceRef",
            "sourceRevision",
            "contentSha256",
            "catalogVersion",
            "mappingVersion",
            "policySchemaVersion",
            "roleMapVersion",
            "foremanRevision",
            "piRuntimeVersion",
            "acquiredAtUtc",
            "evidenceState",
            "freshnessAcceptance"

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foreman-line.local/schemas/provider-binding-projection-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceOnly",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pmc-provider-binding-projection/v1"
    },
    "evidenceOnly": {
      "const": true
    },
    "policy": {

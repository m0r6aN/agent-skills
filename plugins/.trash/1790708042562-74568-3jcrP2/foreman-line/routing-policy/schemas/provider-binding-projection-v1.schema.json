      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "compatibility",
        "provenance",
        "candidates",
        "bindings",
        "lanes",
        "laneBindings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "pmc-provider-binding-policy/v1"
        },
        "compatibility": {
          "const": "additive-v0-preserved"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lanePolicy"
          },
          "maxItems": 6,
          "uniqueItems": true,
          "minItems": 6
        },
        "laneBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/laneBinding"
          },
          "maxItems": 1536,
          "uniqueItems": true
        }
      },
      "$defs": {

{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "bumpType",
    "date",
    "flaggedParcels"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "bumpType": {
      "type": "string",
      "enum": [
        "major",
        "minor"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "flaggedParcels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
